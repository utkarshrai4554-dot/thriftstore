# Gmail SMTP Configuration for OTP Emails
# INSTRUCTIONS:
# 1. Replace YOUR_GMAIL@gmail.com with your actual Gmail address
# 2. Replace YOUR_16CHAR_PASSWORD with your Gmail app password
# 3. Save this file as .env (remove the .template extension)

GMAIL_USER=YOUR_GMAIL@gmail.com
GMAIL_APP_PASSWORD=YOUR_16CHAR_PASSWORD

# Example:
# GMAIL_USER=styleease@gmail.com
# GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# HOW TO GET APP PASSWORD:
# 1. Enable 2-factor authentication on your Google Account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Select "Mail" and "Other (Custom name)"
# 4. Enter "StyleEase OTP" as the name
# 5. Copy the 16-character password (it has spaces)
# 6. Paste it above (keep the spaces)
